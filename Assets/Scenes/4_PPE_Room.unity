  m_text: "\uD63C\uD569\uAE30 \uB0B4\uBD80 \uC810\uAC80 \uBC0F \uCCAD\uC18C \uC791\uC5C5\uC744
    \uBC30\uC815\uBC1B\uC740 \uB2F4\uB2F9\uC790\uAC00 \uBC00\uD3D0\uACF5\uAC04 \uC9C4\uC785
