  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uAD50\uC721 \uBAA8\uB4DC</b>\nPPE \uCC29\uC6A9 \uC808\uCC28\uC640
    \uC218\uD589 \uBC29\uBC95\uC744 \uB2E8\uACC4\uBCC4 \uC548\uB0B4\uC640 \uC74C\uC131\uC73C\uB85C
    \uD559\uC2B5\uD569\uB2C8\uB2E4. \uD544\uC694\uD55C \uC124\uBA85\uACFC \uD53C\uB4DC\uBC31\uC744
    \uC81C\uACF5\uD558\uC5EC \uCC98\uC74C\uBD80\uD130 \uC27D\uAC8C \uB530\uB77C \uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n <b>\uD6C8\uB828 \uBAA8\uB4DC</b>\r\n\uCD5C\uC18C\uD55C\uC758
    \uC791\uC5C5 \uC9C0\uC2DC\uB97C \uB530\uB77C PPE \uCC29\uC6A9 \uACFC\uC815\uC744
    \uC9C1\uC811 \uC218\uD589\uD569\uB2C8\uB2E4. \uC798\uBABB\uB41C \uC120\uD0DD\uC740
    \uC548\uB0B4\uB97C \uD1B5\uD574 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uBA70, \uC2A4\uC2A4\uB85C
    \uC62C\uBC14\uB978 \uBC29\uBC95\uC744 \uC775\uD799\uB2C8\uB2E4.\r\n\r\n <b>\uD14C\uC2A4\uD2B8
    \uBAA8\uB4DC</b>\r\n\uBCC4\uB3C4\uC758 \uB3C4\uC6C0 \uC5C6\uC774 PPE \uCC29\uC6A9
    \uACFC\uC815\uC744 \uB3C5\uB9BD\uC801\uC73C\uB85C \uC218\uD589\uD569\uB2C8\uB2E4.
    \uC815\uB2F5 \uC548\uB0B4\uC640 \uC74C\uC131 \uD53C\uB4DC\uBC31\uC744 \uCD5C\uC18C\uD654\uD558\uACE0,
    \uCD5C\uC885 \uC218\uD589 \uACB0\uACFC\uB97C \uD3C9\uAC00\uD569\uB2C8\uB2E4."
